{
  "name": "ai-model-db",
  "productName": "AI Model DB",
  "private": true,
  "version": "0.8.0",
  "description": "A comprehensive database for tracking and managing AI models across multiple providers",
  "author": "AI Model DB",
  "license": "MIT",
  "main": "electron/main.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/Jeremy8776/AIModelDB.git"
  },
  "scripts": {
    "dev": "vite",
    "dev:prod": "cross-env VITE_FORCE_PROD=true vite",
    "build": "vite build",
    "build:check": "tsc -b && vite build",
    "start": "vite preview --port 5173",
    "preview": "vite preview",
    "serve": "cross-env VITE_USE_PROXY=true node server/index.js",
    "build:serve": "cross-env VITE_USE_PROXY=true npm run build && cross-env VITE_USE_PROXY=true node server/index.js",
    "perf": "node scripts/perf-probe.mjs",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:headed": "playwright test --headed",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "electron:dev": "concurrently -k \"cross-env BROWSER=none npm run dev\" \"wait-on http://localhost:5173 && cross-env NODE_ENV=development electron .\"",
    "electron:build": "npm run build && electron-builder",
    "electron:build:win": "npm run build && electron-builder --win",
    "electron:build:mac": "npm run build && electron-builder --mac",
    "electron:build:linux": "npm run build && electron-builder --linux",
    "electron:start": "cross-env NODE_ENV=production electron .",
    "electron:publish": "npm run build && electron-builder --publish always",
    "lint": "eslint src --ext .ts,.tsx --max-warnings 50",
    "lint:fix": "eslint src --ext .ts,.tsx --fix"
  },
  "dependencies": {
    "@tanstack/react-virtual": "^3.14.20",
    "@vitalets/google-translate-api": "^9.2.1",
    "electron-updater": "^6.6.2",
    "i18next": "^26.4.6",
    "i18next-browser-languagedetector": "^8.2.1",
    "lucide-react": "^0.452.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-i18next": "^17.0.18",
    "react-icons": "^5.7.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^18.2.55",
    "@types/react-dom": "^18.2.19",
    "@typescript-eslint/parser": "^8.71.2",
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.6.1",
    "cheerio": "^1.2.0",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^44.7.2",
    "electron-builder": "26.6.0",
    "eslint": "^9.39.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "fake-indexeddb": "^6.2.5",
    "http-proxy-middleware": "^4.2.0",
    "jsdom": "^27.3.0",
    "postcss": "^8.5.12",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.4.0",
    "vite": "^8.3.4",
    "vitest": "^4.1.0",
    "wait-on": "^9.5.1"
  },
  "build": {
    "appId": "com.aimodeldb",
    "productName": "AI Model DB",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "public/**/*"
    ],
    "publish": {
      "provider": "github",
      "owner": "Jeremy8776",
      "repo": "AIModelDB"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "public/icons/win/icon.ico",
      "artifactName": "AI-Model-DB-Setup.exe",
      "asarUnpack": [
        "**/node_modules/@vitalets/google-translate-api"
      ],
      "verifyUpdateCodeSignature": false
    },
    "mac": {
      "target": "dmg",
      "icon": "public/icons/mac/icon.icns",
      "asarUnpack": [
        "**/node_modules/@vitalets/google-translate-api"
      ],
      "category": "public.app-category.developer-tools",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "electron/entitlements.mac.plist",
      "entitlementsInherit": "electron/entitlements.mac.plist",
      "notarize": false,
      "artifactName": "AI-Model-DB.dmg"
    },
    "dmg": {
      "background": "resources/dmg_background.png",
      "iconSize": 100,
      "window": {
        "width": 540,
        "height": 380
      },
      "contents": [
        {
          "x": 130,
          "y": 190,
          "type": "file"
        },
        {
          "x": 410,
          "y": 190,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "linux": {
      "target": "AppImage",
      "icon": "public/icons/png",
      "category": "Development",
      "artifactName": "AI-Model-DB.AppImage"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true,
      "installerHeader": "build/installerHeader.bmp",
      "installerSidebar": "build/installerSidebar.bmp",
      "license": "build/license.txt",
      "include": "build/installer.nsh",
      "artifactName": "AI-Model-DB-Setup.exe"
    }
  }
}
